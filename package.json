{
  "name": "dsh-plugin-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Codex and Claude Code Skill plus project generator for DeepSeek Harness plugin development",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "skills/dsh-plugin-dev/**",
    "scripts/install-user-skill.mjs",
    "scripts/baseline.mjs",
    "baselines/**",
    "docs/agent/BASELINE_UPGRADE.md",
    "docs/decisions/0004-baseline-channels.md",
    "dsh-reference.lock.json",
    "README.md"
  ],
  "scripts": {
    "context:check": "node scripts/verify-context.mjs",
    "context:check:strict": "node scripts/verify-context.mjs --require-source",
    "context:check:edge": "node scripts/verify-context.mjs --require-source --channel edge",
    "upstream:scan": "node scripts/baseline.mjs scan",
    "upstream:update": "node scripts/baseline.mjs update --channel edge",
    "upstream:diff": "node scripts/baseline.mjs diff --from stable --to edge",
    "upstream:check": "node scripts/baseline.mjs check",
    "registry:check": "node scripts/baseline.mjs registry-check",
    "baseline:verify": "node scripts/baseline.mjs verify --channel edge",
    "baseline:promote": "node scripts/baseline.mjs promote --from edge --to stable",
    "release:preflight": "node scripts/baseline.mjs preflight --channel stable",
    "install:skill": "node scripts/install-user-skill.mjs",
    "install:codex": "node scripts/install-user-skill.mjs --agent codex",
    "install:claude": "node scripts/install-user-skill.mjs --agent claude",
    "test": "node --test tests/*.unit.test.mjs",
    "test:e2e": "node --test tests/*.e2e.test.mjs",
    "verify": "pnpm context:check:strict && pnpm test && pnpm test:e2e"
  }
}
