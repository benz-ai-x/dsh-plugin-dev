{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "lib/index.d.ts.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "context:check": "node scripts/verify-dsh-context.mjs",
    "context:check:strict": "node scripts/verify-dsh-context.mjs --require-source",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:loader": "vitest run tests/loader.spec.ts",
    "build": "tsc -p tsconfig.json",
    "pack:check": "node scripts/verify-pack.mjs",
    "verify": "pnpm context:check:strict && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "__CORDIS_LINK__",
    "@deepseek-ai/cordis-plugin-include": "__INCLUDE_LINK__",
    "@deepseek-ai/cordis-plugin-loader": "__LOADER_LINK__",
    "@deepseek-ai/dsh-llm": "__DSH_LLM_LINK__",
    "@deepseek-ai/dsh-system-prompt": "__SYSTEM_PROMPT_LINK__",
    "@deepseek-ai/dsh-tools": "__DSH_TOOLS_LINK__",
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
