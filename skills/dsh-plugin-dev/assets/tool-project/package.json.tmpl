{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "private": true,
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "__PACKAGE_MANAGER__",
  "engines": {
    "node": "__NODE_ENGINE__"
  },
  "scripts": {
    "context:check": "node scripts/verify-dsh-context.mjs",
    "context:check:strict": "node scripts/verify-dsh-context.mjs --require-source",
    "context:sync": "node scripts/verify-dsh-context.mjs --sync-links --require-source && pnpm install --no-frozen-lockfile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:loader": "vitest run tests/loader.spec.ts",
    "build": "tsc -p tsconfig.json",
    "built:check": "node scripts/verify-built.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "verify": "pnpm context:check:strict && pnpm typecheck && pnpm test && pnpm build && pnpm built:check && pnpm pack:check",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "__SCHEMASTERY_VERSION__"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "__CORDIS_PEER_VERSION__",
    "@deepseek-ai/dsh-tools": "__DSH_TOOLS_VERSION__"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "__CORDIS_LINK__",
    "@deepseek-ai/cordis-plugin-include": "__INCLUDE_LINK__",
    "@deepseek-ai/cordis-plugin-loader": "__LOADER_LINK__",
    "@deepseek-ai/dsh-llm": "__DSH_LLM_LINK__",
    "@deepseek-ai/dsh-system-prompt": "__SYSTEM_PROMPT_LINK__",
    "@deepseek-ai/dsh-tools": "__DSH_TOOLS_LINK__",
    "@types/node": "__TYPES_NODE_VERSION__",
    "typescript": "__TYPESCRIPT_VERSION__",
    "vitest": "__VITEST_VERSION__"
  }
}
